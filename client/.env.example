# sane uses the USB scanner. fake returns a sample bed so the pipeline can run
# without hardware.
SCANNER_BACKEND=sane

# Directory for persisted settings, the last scan result, and the latest capture.
DATA_DIR=/data

# Seed values used only when no settings file exists yet. Later edits in the
# web UI are stored under DATA_DIR and win over these variables.
SERVER_URL=http://homeserver.local:8080
API_TOKEN=change-me
RESOLUTION_DPI=300
IMAGE_FORMAT=tiff
