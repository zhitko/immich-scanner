# sane uses the USB scanner. fake returns a sample bed so the pipeline can
# run without hardware. Changing this requires a restart.
SCANNER_BACKEND=sane

# Persistent SQLite database, original scans, and cropped previews.
DATA_DIR=/data

# Built Angular app. The image already sets this to /app/static.
STATIC_DIR=/app/static

# Optional seeds used only while the matching setting is still empty.
# After the first save, the settings page wins.
RESOLUTION_DPI=300
SCAN_FORMAT=tiff
IMMICH_BASE_URL=
IMMICH_API_KEY=

# Native installs: OpenVINO requires the alternate runtime and Intel compute driver.
# Docker: use docker-compose.intel-gpu.yml to install these and expose /dev/dri.
RETOUCH_EXECUTION=cpu
RETOUCH_OPENVINO_DEVICE=GPU
